
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>James Ermac | Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background: #0f172a;
            color: white;
        }

        /* NAVIGATION */
        header {
            background: #111c33;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #38bdf8;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-size: 15px;
        }

        nav a:hover {
            color: #38bdf8;
        }

        /* HOME */
        .home {
            min-height: 90vh;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 60px 10%;
            gap: 40px;
        }

        .home-content h3 {
            font-size: 25px;
            color: #38bdf8;
        }

        .home-content h1 {
            font-size: 55px;
            margin: 15px 0;
        }

        .home-content p {
            color: #cbd5e1;
            line-height: 1.8;
            max-width: 550px;
        }

        .home-content button {
            margin-top: 25px;
            padding: 13px 25px;
            background: #38bdf8;
            color: #0f172a;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
        }

        .home-content button:hover {
            background: white;
        }

        .profile {
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: linear-gradient(135deg, #38bdf8, #6366f1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 85px;
            font-weight: bold;
            color: #0f172a;
            border: 7px solid #1e293b;
        }

        /* GENERAL SECTIONS */
        section {
            padding: 80px 10%;
        }

        .section-title {
            text-align: center;
            font-size: 35px;
            margin-bottom: 40px;
            color: #38bdf8;
        }

        /* ABOUT */
        .about {
            background: #111c33;
            text-align: center;
        }

        .about p {
            max-width: 800px;
            margin: auto;
            line-height: 1.9;
            color: #cbd5e1;
        }

        /* SKILLS */
        .skills-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .skill {
            background: #1e293b;
            padding: 20px 35px;
            border-radius: 12px;
            border: 1px solid #38bdf8;
            transition: .3s;
        }

        .skill:hover {
            transform: translateY(-7px);
            background: #38bdf8;
            color: #0f172a;
        }

        /* PROJECTS */
        .projects-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .project-card {
            background: #1e293b;
            padding: 30px;
            border-radius: 15px;
            transition: .3s;
        }

        .project-card:hover {
            transform: translateY(-8px);
        }

        .project-card h3 {
            color: #38bdf8;
            margin-bottom: 15px;
        }

        .project-card p {
            color: #cbd5e1;
            line-height: 1.7;
        }

        /* EDUCATION */
        .education {
            background: #111c33;
            text-align: center;
        }

        .education-box {
            background: #1e293b;
            padding: 30px;
            border-radius: 15px;
            max-width: 650px;
            margin: auto;
        }

        .education-box h3 {
            color: #38bdf8;
            margin-bottom: 10px;
        }

        .education-box p {
            color: #cbd5e1;
            line-height: 1.8;
        }

        /* CONTACT */
        .contact {
            text-align: center;
        }

        .contact p {
            margin: 15px;
            color: #cbd5e1;
        }

        .contact a {
            color: #38bdf8;
            text-decoration: none;
        }

        /* FOOTER */
        footer {
            background: #111c33;
            text-align: center;
            padding: 20px;
            color: #cbd5e1;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 12px;
            }

            nav a {
                margin: 0;
            }

            .home {
                flex-direction: column-reverse;
                text-align: center;
            }

            .home-content h1 {
                font-size: 40px;
            }

            .profile {
                width: 200px;
                height: 200px;
                font-size: 60px;
            }

            .projects-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->
    <header>
        <div class="logo">JAMES.</div>

        <nav>
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#skills">Skills</a>
            <a href="#projects">Projects</a>
            <a href="#education">Education</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <!-- HOME SECTION -->
    <section class="home" id="home">

        <div class="home-content">
            <h3>Hello, Welcome to My Portfolio!</h3>

            <h1>I'm James Ermac</h1>

            <p>
                Welcome to my personal portfolio website.
                I am a motivated individual who enjoys learning
                new things, developing my skills, and exploring
                opportunities for personal and professional growth.
            </p>

            <button onclick="location.href='#about'">
                Learn More About Me
            </button>
        </div>

        <div class="profile">
            JE
        </div>

    </section>

    <!-- ABOUT SECTION -->
    <section class="about" id="about">

        <h2 class="section-title">About Me</h2>

        <p>
            My name is James Ermac. I am a dedicated and
            hardworking individual who believes that learning
            is a continuous process. I enjoy discovering new
            ideas, improving my abilities, and challenging
            myself to become better. I believe that determination,
            discipline, and positive thinking are important
            in achieving my goals.
        </p>

    </section>

    <!-- SKILLS SECTION -->
    <section id="skills">

        <h2 class="section-title">My Skills</h2>

        <div class="skills-container">

            <div class="skill">Communication</div>
            <div class="skill">Teamwork</div>
            <div class="skill">Creativity</div>
            <div class="skill">Problem Solving</div>
            <div class="skill">Time Management</div>
            <div class="skill">Computer Skills</div>

        </div>

    </section>

    <!-- PROJECTS SECTION -->
    <section id="projects">

        <h2 class="section-title">My Projects</h2>

        <div class="projects-container">

            <div class="project-card">
                <h3>Project 01</h3>
                <p>
                    Add a description of your first project,
                    including its purpose and what you learned.
                </p>
            </div>

            <div class="project-card">
                <h3>Project 02</h3>
                <p>
                    Add your second project, school activity,
                    presentation, or personal work.
                </p>
            </div>

            <div class="project-card">
                <h3>Project 03</h3>
                <p>
                    Showcase another project that demonstrates
                    your creativity, knowledge, and abilities.
                </p>
            </div>

        </div>

    </section>

    <!-- EDUCATION SECTION -->
    <section class="education" id="education">

        <h2 class="section-title">My Education</h2>

        <div class="education-box">
            <h3>Educational Background</h3>

            <p>
                School: Your School Name
                <br>
                Course/Strand: Your Course or Strand
                <br>
                Year Level: Your Year Level
            </p>
        </div>

    </section>

    <!-- CONTACT SECTION -->
    <section class="contact" id="contact">

        <h2 class="section-title">Contact Me</h2>

        <p>
            Thank you for visiting my portfolio!
            Feel free to connect with me.
        </p>

        <p>Email:
            <a href="mailto:your@email.com">
                your@email.com
            </a>
        </p>

        <p>Facebook:
            <a href="https://www.facebook.com/">
                My Facebook Profile
            </a>
        </p>

    </section>

    <!-- FOOTER -->
    <footer>
        <p>
            © 2026 James Ermac | All Rights Reserved.
        </p>
    </footer>

</body>
</html>

